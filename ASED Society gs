// Helper: Safe Date String Formatter (DD-MM-YYYY)
function formatDateDDMMYYYY(val) {
  if (!val) return "";
  if (val instanceof Date) {
    const day = String(val.getDate()).padStart(2, '0');
    const month = String(val.getMonth() + 1).padStart(2, '0');
    const year = val.getFullYear();
    return `${day}-${month}-${year}`;
  }
  return String(val);
}

// Helper: Format DateTime for Audit Logs
function formatDateTime(dateObj) {
  if (!dateObj) return "";
  const d = new Date(dateObj);
  if (isNaN(d.getTime())) return "";
  const dateStr = formatDateDDMMYYYY(d);
  const hours = String(d.getHours()).padStart(2, '0');
  const mins = String(d.getMinutes()).padStart(2, '0');
  const secs = String(d.getSeconds()).padStart(2, '0');
  return `${dateStr} ${hours}:${mins}:${secs}`;
}

// ==================== AUTHENTICATION ====================
function checkLogin(paId, pin) {
  const ss = getSpreadsheet();
  const sheet = ss.getSheetByName("S6IDpin");
  if (!sheet) return { success: false, message: "S6IDpin Sheet Not Found!" };
  
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (String(row[0]).trim() === String(paId).trim() && String(row[3]).trim() === String(pin).trim()) {
      if (String(row[4]).trim().toLowerCase() === "active") {
        return {
          success: true,
          user: {
            id: row[0],
            name: row[1],
            permission: String(row[5]).trim()
          }
        };
      } else {
        return { success: false, message: "User is Inactive!" };
      }
    }
  }
  return { success: false, message: "Invalid ID or PIN!" };
}

// ==================== FETCH MSS DETAILS ====================
function getMSSDetails(mssNo) {
  const ss = getSpreadsheet();
  const sheet = ss.getSheetByName("S1MSSList");
  if (!sheet) return { success: false, message: "S1MSSList sheet not found!" };
  
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === String(mssNo).trim()) {
      let rawDate = data[i][4];
      let formattedDate = formatDateDDMMYYYY(rawDate);
      return {
        success: true,
        data: {
          mssNo: data[i][0],
          name: data[i][1],
          address: data[i][2],
          mobile: data[i][3],
          acOpenDate: formattedDate,
          yrsMonths: data[i][5],
          installment: data[i][6]
        }
      };
    }
  }
  return { success: false, message: "MSS No Not Found in S1MSSList!" };
}

// Helper: Sync S1MSSList and S5Master Columns A to G
function syncMasterAndMSSList(data) {
  const ss = getSpreadsheet();
  
  // 1. Update/Add S1MSSList
  const sheet1 = ss.getSheetByName("S1MSSList");
  const data1 = sheet1.getDataRange().getValues();
  let found1 = false;
  for (let i = 1; i < data1.length; i++) {
    if (String(data1[i][0]).trim() === String(data.mssNo).trim()) {
      sheet1.getRange(i + 1, 1, 1, 7).setValues([[
        data.mssNo, data.name, data.address, data.mobile, data.acOpenDate, data.yrsMonths, data.installment
      ]]);
      found1 = true;
      break;
    }
  }
  if (!found1) {
    sheet1.appendRow([data.mssNo, data.name, data.address, data.mobile, data.acOpenDate, data.yrsMonths, data.installment]);
  }

  // 2. Update/Add S5Master A-G
  const sheet5 = ss.getSheetByName("S5Master");
  const data5 = sheet5.getDataRange().getValues();
  let found5 = false;
  for (let i = 1; i < data5.length; i++) {
    if (String(data5[i][0]).trim() === String(data.mssNo).trim()) {
      sheet5.getRange(i + 1, 1, 1, 7).setValues([[
        data.mssNo, data.name, data.address, data.mobile, data.acOpenDate, data.yrsMonths, data.installment
      ]]);
      found5 = true;
      break;
    }
  }
  if (!found5) {
    let newRow = new Array(16).fill("");
    newRow[0] = data.mssNo;
    newRow[1] = data.name;
    newRow[2] = data.address;
    newRow[3] = data.mobile;
    newRow[4] = data.acOpenDate;
    newRow[5] = data.yrsMonths;
    newRow[6] = data.installment;
    sheet5.appendRow(newRow);
  }
}

// Helper: Send Email Notification
function sendEmailNotification(subject, body) {
  try {
    MailApp.sendEmail(NOTIFICATION_EMAIL, subject, body);
  } catch (e) {
    Logger.log("Email Notification Error: " + e.message);
  }
}

// ==================== SUBMIT REC SAVING ====================
function submitRecSaving(form, userId) {
  const ss = getSpreadsheet();
  const now = new Date();
  const formattedDate = formatDateDDMMYYYY(now);
  const formattedDateTimeStr = formatDateTime(now);
  
  syncMasterAndMSSList(form);
  
  const sheet2 = ss.getSheetByName("S2RecSaving");
  sheet2.appendRow([
    formattedDate, form.mssNo, form.name, form.address, form.mobile,
    form.acOpenDate, form.yrsMonths, form.installment,
    Number(form.installCount || 0), Number(form.amount || 0), form.remarks
  ]);
  
  const sheet5 = ss.getSheetByName("S5Master");
  const data5 = sheet5.getDataRange().getValues();
  for (let i = 1; i < data5.length; i++) {
    if (String(data5[i][0]).trim() === String(form.mssNo).trim()) {
      let currentInstCount = Number(data5[i][7] || 0);
      let newInstCount = currentInstCount + Number(form.installCount || 0);
      sheet5.getRange(i + 1, 8).setValue(newInstCount);
      sheet5.getRange(i + 1, 16).setValue(userId + " & " + formattedDateTimeStr);
      break;
    }
  }

  const emailSubject = `[ASED App] Rec Saving Entry - MSS: ${form.mssNo}`;
  const emailBody = `New Rec Saving Entry Details:\n\nDate: ${formattedDate}\nMSS No: ${form.mssNo}\nName: ${form.name}\nInstallments Count: ${form.installCount}\nAmount: ${form.amount}\nSubmitted By User ID: ${userId}\nDate & Time: ${formattedDateTimeStr}`;
  sendEmailNotification(emailSubject, emailBody);

  return { success: true, message: "Rec Saving entry saved successfully!" };
}

