// ==================== SUBMIT REC SAVING (UPDATED) ====================
function submitRecSaving(form, userId) {
  const ss = getSpreadsheet();
  const now = new Date();
  const formattedDate = formatDateDDMMYYYY(now);
  const formattedDateTimeStr = formatDateTime(now);
  
  // 1. Update/Sync S1MSSList and S5Master (Columns A to G)
  syncMasterAndMSSList(form);
  
  // 2. Append Entry into S2RecSaving Sheet
  const sheet2 = ss.getSheetByName("S2RecSaving");
  sheet2.appendRow([
    formattedDate, form.mssNo, form.name, form.address, form.mobile,
    form.acOpenDate, form.yrsMonths, form.installment,
    Number(form.installCount || 0), Number(form.amount || 0), form.remarks
  ]);
  
  // 3. Update S5Master: Accumulate Month Count (Col H) & Principal Amount (Col K)
  const sheet5 = ss.getSheetByName("S5Master");
  const data5 = sheet5.getDataRange().getValues();
  let foundInMaster = false;
  
  const addedInstallCount = Number(form.installCount || 0);
  const addedAmount = Number(form.amount || 0);

  for (let i = 1; i < data5.length; i++) {
    if (String(data5[i][0]).trim() === String(form.mssNo).trim()) {
      let currentInstCount = Number(data5[i][7] || 0); // Col H (Index 7)
      let currentPrincipal = Number(data5[i][10] || 0); // Col K (Index 10)
      
      let newInstCount = currentInstCount + addedInstallCount;
      let newPrincipal = currentPrincipal + addedAmount; // Principal-এ টাকা যোগ হচ্ছে
      
      sheet5.getRange(i + 1, 8).setValue(newInstCount);  // Col H (Month কিস্তি)
      sheet5.getRange(i + 1, 11).setValue(newPrincipal); // Col K (Principal)
      sheet5.getRange(i + 1, 16).setValue(userId + " & " + formattedDateTimeStr); // Col P (Audit)
      
      foundInMaster = true;
      break;
    }
  }

  // যদি কোনো কারণে S5Master-এ আগে না থাকে (নতুন এন্ট্রি)
  if (!foundInMaster) {
    let newRow = new Array(16).fill("");
    newRow[0] = form.mssNo;
    newRow[1] = form.name;
    newRow[2] = form.address;
    newRow[3] = form.mobile;
    newRow[4] = form.acOpenDate;
    newRow[5] = form.yrsMonths;
    newRow[6] = form.installment;
    newRow[7] = addedInstallCount; // Col H
    newRow[10] = addedAmount;      // Col K (Principal)
    newRow[15] = userId + " & " + formattedDateTimeStr; // Col P
    sheet5.appendRow(newRow);
  }

  // Email Notification
  const emailSubject = `[ASED App] Rec Saving Entry - MSS: ${form.mssNo}`;
  const emailBody = `New Rec Saving Entry Details:\n\nDate: ${formattedDate}\nMSS No: ${form.mssNo}\nName: ${form.name}\nInstallments Count: ${form.installCount}\nAmount Added to Principal: ${addedAmount}\nSubmitted By User ID: ${userId}\nDate & Time: ${formattedDateTimeStr}`;
  sendEmailNotification(emailSubject, emailBody);

  return { success: true, message: "Rec Saving entry saved & Principal updated successfully!" };
}


// Master Search Table Query Function (Updated with Object Mapping)
function searchMasterData(searchText) {
  const ss = getSpreadsheet();
  const sheet = ss.getSheetByName("S5Master");
  const data = sheet.getDataRange().getValues();
  
  if (data.length <= 1) return [];
  
  // Header বাদ দিয়ে ২য় সারি থেকে নেওয়া হচ্ছে
  const rows = data.slice(1);
  
  // ১. প্রথমে অ্যারে থেকে অবজেক্টে রূপান্তর
  const mappedData = rows.map(row => {
    return {
      mssNo: row[0] || '',
      name: row[1] || '',
      acOpenDt: row[4] ? formatDateDDMMYYYY(row[4]) : '', // Col E
      yrs: row[5] || '',                                  // Col F
      installment: row[6] || 0,                           // Col G
      monthKisti: row[7] || 0,                            // Col H
      futureValue: row[9] || 0,                           // Col J (Index 9) - Future Value
      principal: row[10] || 0,                            // Col K (Index 10) - Principal
      remarks: row[14] || ''                              // Col O (Index 14) - Remarks
    };
  });
  
  // সার্চ ফিল্টার খালি থাকলে পুরো তালিকা পাঠাবে
  if (!searchText || searchText.trim() === "") {
    return mappedData;
  }
  
  const query = searchText.toString().toLowerCase().trim();
  
  // ২. MSS No অথবা Name দিয়ে অবজেক্ট ফিল্টার
  return mappedData.filter(item => {
    const mssNo = String(item.mssNo).toLowerCase();
    const name = String(item.name).toLowerCase();
    return mssNo.includes(query) || name.includes(query);
  });
}
