<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body { background-color: #f1f8f1; font-family: 'Segoe UI', Arial, sans-serif; }
    .header-box { background: #1b5e20; color: white; padding: 15px; text-align: center; border-radius: 10px 10px 0 0; }
    .main-card { 
      background-color: #e8f5e9; padding: 25px; border-radius: 0 0 10px 10px;
      max-width: 800px; margin: 0 auto 50px auto; border: 1px solid #c8e6c9; display: none;
    }
    .form-control, .form-select { background-color: #ffffff !important; border: 1px solid #a5d6a7; }
    label { font-weight: bold; color: #1b5e20; margin-top: 10px; display: block; }
    .btn-logout { background-color: #d32f2f; color: white; border: none; font-weight: bold; }
    #loader { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.8); z-index: 9999; justify-content: center; align-items: center; }
  </style>
</head>
<body>

<div id="loader"><div class="spinner-border text-success"></div></div>

<div id="login-box" class="container" style="max-width: 400px; margin-top: 100px;">
  <div class="card shadow-lg p-4">
    <h4 class="text-center text-success mb-4">PA লগইন</h4>
    <input type="text" id="l_id" class="form-control mb-3" placeholder="ইউজার আইডি">
    <input type="password" id="l_pin" class="form-control mb-3" placeholder="পিন কোড">
    <button class="btn btn-success w-100 fw-bold" onclick="login()">প্রবেশ করুন</button>
  </div>
</div>

<div id="app-content" class="container mt-4">
  <div class="header-box shadow">
    <h2 style="margin: 0;">আশেক আর্থ-সামাজিক উন্নয়ন সমিতি</h2>
  </div>
  <div class="main-card shadow">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-success">
      <span>ইউজার: <b id="user-display" class="text-success"></b></span>
      <button class="btn btn-logout btn-sm px-3" onclick="location.reload()">লগআউট</button>
    </div>

    <form id="entryForm" class="row g-3">
      <div class="col-md-6"><label>নাম</label><input type="text" id="name" class="form-control"></div>
      <div class="col-md-6"><label>পিতা/স্বামীর নাম</label><input type="text" id="guardian" class="form-control"></div>
      <div class="col-md-3"><label>বয়স</label><input type="text" id="age" class="form-control"></div>
      <div class="col-md-9"><label>ঠিকানা (গ্রাম)</label><select id="addressSel" class="form-select"></select></div>
      <div class="col-md-6"><label>বাড়ি</label><input type="text" id="house" class="form-control"></div>
      <div class="col-md-6"><label>মোবাইল নম্বর</label><input type="text" id="mobile" class="form-control"></div>
      <div class="col-md-12"><label>প্রাথমিক মতামত</label><select id="opinion" class="form-select"></select></div>
      <div class="col-md-12"><label>মন্তব্য</label><textarea id="note" class="form-control" rows="2"></textarea></div>
      <div class="col-12 mt-4 text-center">
        <button type="button" class="btn btn-success btn-lg w-100 fw-bold shadow" onclick="submitForm()">ডাটা সাবমিট করুন</button>
      </div>
    </form>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
let currentUser = {};

function login() {
  const id = $('#l_id').val();
  const pin = $('#l_pin').val();
  if(!id || !pin) return Swal.fire('Error', 'আইডি এবং পিন দিন', 'warning');
  
  $('#loader').css('display', 'flex');
  google.script.run.withSuccessHandler(res => {
    $('#loader').hide();
    if(res.status) {
      currentUser = res;
      $('#login-box').hide();
      $('.main-card').show();
      $('#user-display').text(res.name);
      loadDropdowns();
    } else { Swal.fire('ব্যর্থ!', res.msg, 'error'); }
  }).verifyUser(id, pin);
}

function loadDropdowns() {
  google.script.run.withSuccessHandler(data => {
    let addr = '<option value="">ঠিকানা নির্বাচন করুন</option>';
    data.address.forEach(item => addr += `<option value="${item}">${item}</option>`);
    $('#addressSel').html(addr);

    let op = '<option value="">মতামত নির্বাচন করুন</option>';
    data.opinion.forEach(item => op += `<option value="${item}">${item}</option>`);
    $('#opinion').html(op);
  }).getDropdownData();
}

function submitForm() {
  const fd = {
    paId: currentUser.id,
    paName: currentUser.name,
    name: $('#name').val(),
    guardian: $('#guardian').val(),
    age: $('#age').val(),
    addressSel: $('#addressSel').val(),
    house: $('#house').val(), // সংশোধিত: আইডি ও কী (Key) মিলানো হয়েছে
    mobile: $('#mobile').val(),
    opinion: $('#opinion').val(),
    note: $('#note').val()
  };

  if(!fd.name || !fd.addressSel) return Swal.fire('সতর্কতা', 'নাম এবং ঠিকানা আবশ্যক', 'warning');

  $('#loader').css('display', 'flex');
  google.script.run.withSuccessHandler(msg => {
    $('#loader').hide();
    Swal.fire('সফল!', msg, 'success');
    $('#entryForm')[0].reset(); 
  }).submitData(fd);
}
</script>
</body>
</html>
